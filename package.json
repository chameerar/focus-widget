{
  "name": "focus-widget",
  "productName": "Focus Widget",
  "version": "0.1.0",
  "description": "A desktop countdown widget with a segmented dial and quick timers.",
  "keywords": [
    "timer",
    "countdown",
    "pomodoro",
    "focus",
    "widget",
    "electron"
  ],
  "license": "MIT",
  "private": true,
  "main": "main.js",
  "desktopName": "focus-widget.desktop",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder"
  },
  "devDependencies": {
    "electron": "45.3.0",
    "electron-builder": "26.18.0"
  },
  "build": {
    "appId": "com.example.focuswidget",
    "productName": "Focus Widget",
    "artifactName": "${name}-${version}-${os}-${arch}.${ext}",
    "files": [
      "main.js",
      "preload.js",
      "renderer/**",
      "assets/**"
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "icon": "assets/icon.png",
      "identity": "-",
      "hardenedRuntime": false,
      "notarize": false,
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ]
    },
    "win": {
      "icon": "assets/icon.png",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "linux": {
      "icon": "assets/icon.png",
      "category": "Utility",
      "syncDesktopName": true,
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        }
      ]
    }
  }
}
